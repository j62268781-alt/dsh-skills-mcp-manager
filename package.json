{
  "name": "@local/dsh-skills-mcp-panel",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Settings panel that manages Skills and MCP servers for the project and globally.",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node --check src/index.js && node --check lib/client.js",
    "test": "node test-import-sources.mjs",
    "verify": "node verify-served.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "*",
    "react": "*",
    "yaml": "*",
    "zod": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "yaml": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
