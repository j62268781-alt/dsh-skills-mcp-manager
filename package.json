{
  "name": "@j62268781-alt/dsh-skills-mcp-manager",
  "version": "0.4.1",
  "type": "module",
  "description": "DSH 设置面板：一个页面里管理技能（SKILL.md）与 MCP 服务器，全局 / 项目级分层，改完即生效。Manage skills and MCP servers from the DSH settings panel — global and per-project tiers, effective immediately.",
  "license": "MIT",
  "author": "j62268781-alt",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "skills",
    "skill",
    "mcp",
    "mcp-servers",
    "settings-panel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j62268781-alt/dsh-skills-mcp-manager.git"
  },
  "homepage": "https://github.com/j62268781-alt/dsh-skills-mcp-manager#readme",
  "bugs": {
    "url": "https://github.com/j62268781-alt/dsh-skills-mcp-manager/issues"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node --check src/index.js && node --check lib/client.js",
    "test": "node --import ./scripts/jsx-register.mjs --test",
    "verify": "node verify-served.mjs",
    "deploy": "node scripts/deploy.mjs",
    "gate": "npm run check:names && npm run build:client && npm test && npm run smoke && node scripts/preview-check.mjs",
    "preview": "node scripts/preview-check.mjs",
    "predeploy": "npm run build",
    "prepare": "npm run build",
    "smoke": "node scripts/host-smoke.mjs",
    "check:names": "node scripts/undefined-check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "*",
    "react": "*",
    "yaml": "*",
    "zod": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "yaml": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0"
  },
  "files": [
    "dist",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "yaml": "^2.9.1"
  }
}
